{
    "name": "polychromatic-theme",
    "displayName": "Polychromatic Theme",
    "description": "A colour theme, file icon theme and product icon theme for VS Code which supports light and dark mode.",
    "publisher": "ottowolfenden",
    "repository": "https://github.com/ottowolfenden/polychromatic-theme",
    "license": "MIT",
    "icon": "assets/icon.png",
    "version": "5.1.3",
    "engines": {
        "vscode": "^1.51.0"
    },
    "categories": [
        "Themes"
    ],
    "main": "./extension.js",
    "activationEvents": [
        "onStartupFinished"
    ],
    "contributes": {
        "themes": [
            {
                "id": "polychromatic-dark-colour-theme",
                "label": "Polychromatic Dark Colour Theme",
                "uiTheme": "vs-dark",
                "path": "./colour-theme/dark.json"
            },
            {
                "id": "polychromatic-light-colour-theme",
                "label": "Polychromatic Light Colour Theme",
                "uiTheme": "vs",
                "path": "./colour-theme/light.json"
            }
        ],
        "iconThemes": [
            {
                "id": "polychromatic-file-icon-theme",
                "label": "Polychromatic File Icon Theme",
                "path": "./file-icon-theme/file-icon-theme.json"
            }
        ],
        "productIconThemes": [
            {
                "id": "polychromatic-product-icon-theme",
                "label": "Polychromatic Product Icon Theme",
                "path": "./product-icon-theme/product-icon-theme.json"
            }
        ]
    }
}
