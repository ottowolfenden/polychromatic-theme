{
    "name": "polychromatic-theme",
    "displayName": "Polychromatic Theme",
    "description": "Polychromatic Theme",
    "version": "3.0.0",
    "engines": {
        "vscode": "^1.51.0"
    },
    "categories": [
        "Themes"
    ],
    "main": "./extension.js",
    "activationEvents": [
        "onStartupFinished"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/ottowolfenden/polychromatic-theme.git"
    },
    "license": "MIT",
    "icon": "assets/icon.png",
    "contributes": {
        "themes": [
            {
                "label": "Polychromatic Theme Dark",
                "uiTheme": "vs-dark",
                "path": "./themes/dark.json"
            },
            {
                "label": "Polychromatic Theme Light",
                "uiTheme": "vs",
                "path": "./themes/light.json"
            }
        ],
        "productIconThemes": [
            {
                "id": "Material Symbols",
                "label": "Material Symbols",
                "path": "./product-icon-theme/product-icon-theme.json"
            }
        ]
    }
}
